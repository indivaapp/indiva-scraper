# OnuAl.com taraması için Gemini API anahtarı (PC'de direkt fetch başarısız olursa kullanılır).
# Anahtarı al: https://aistudio.google.com/app/apikey
# .env.example → .env olarak kopyala ve gerçek anahtarı yaz.
GEMINI_API_KEY=AIzaSy_BURAYA_GERCEK_ANAHTARI_YAZ

# Trendyol/Cimri kalite kapısı puanlaması için OpenRouter (DeepSeek v4) anahtarı.
# Anahtarı al: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-BURAYA_GERCEK_ANAHTARI_YAZ
